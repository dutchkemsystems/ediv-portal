# =============================================================================
# EDUCATION DISTRICT IV PORTAL — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=ediv-portal.onrender.com,localhost,127.0.0.1

# Database (PostgreSQL)
POSTGRES_DB=education_district_iv
POSTGRES_USER=ediv_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (optional)
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@ediv.gov.ng

# CORS
FRONTEND_URL=http://localhost:3000

# KoraPay
KORA_PAY_PUBLIC_KEY=
KORA_PAY_SECRET_KEY=
KORA_PAY_WEBHOOK_SECRET=
KORA_PAY_API_URL=https://api.korapay.com/merchant/api/v1

# IP Whitelist (comma-separated; leave empty to allow all)
EDIV_WHITELISTED_IPS=

# =============================================================================
# SEED PASSWORDS — Required for initial data seeding
# =============================================================================
# These are ONLY used by seed_departments, seed_schools, seed_users commands.
# In production, set them via Render env vars or .env file.
# After seeding, you can rotate passwords via the admin portal.
# =============================================================================

ADMIN_PASSWORD=Admin@12345678
TG_PASSWORD=TutorGen@12345
HEAD_OFFICE_PASSWORD=DeptHead@12345
SCHOOL_STAFF_PASSWORD=SchoolStaff@12345
TEACHER_PASSWORD=Teacher@12345
STUDENT_PASSWORD=Student@12345
