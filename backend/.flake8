[flake8]
max-line-length = 120
extend-ignore = E203,W503
exclude = migrations,.git,__pycache__

per-file-ignores =
    config/settings/base.py:F401,F403,F405
    config/settings/local.py:F401,F403,F405
    config/settings/test.py:F401,F403,F405
    config/settings/development.py:F401,F403,F405
    config/settings/production.py:F401,F403,F405