# Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# API URL - Use /api for production (proxied through backend)
VITE_API_URL=/api

# For local development, use:
# VITE_API_URL=http://localhost:8000/api

# Mirror of backend REGISTRY_AUTO_TASK flag - set to true to show the
# auto-assignment banner in MailWorkflow
VITE_REGISTRY_AUTO_TASK=false
